{
  "name": "pnmtd-webui",
  "private": true,
  "version": "1.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e",
    "gen:api": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "check:api": "openapi-typescript src/api/openapi.json -o /tmp/schema.d.ts && cmp -s /tmp/schema.d.ts src/api/schema.d.ts || (echo 'src/api/schema.d.ts is not generated from openapi.json: tools/npm.sh run gen:api' >&2; exit 1)",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@milkdown/crepe": "7.23.0",
    "@milkdown/kit": "7.23.0",
    "@primeuix/themes": "2.0.3",
    "@tanstack/vue-query": "5.107.1",
    "age-encryption": "0.3.1",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "mermaid": "12.3.0",
    "monaco-editor": "0.57.0",
    "openapi-fetch": "0.17.0",
    "pinia": "4.1.0",
    "primeicons": "7.0.0",
    "primevue": "4.5.5",
    "qrcode": "1.5.4",
    "rehype-highlight": "7.0.2",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "vue": "3.5.45",
    "vue-router": "5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
