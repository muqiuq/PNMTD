<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The PNMT sensor service (docs/windows-sensor-plan.md §3.1): one Windows executable with .NET included, a window, a
    service mode and a command line. EnableWindowsTargeting lets it build on macOS and on Linux runners; tools/agent.sh
    publishes it single-file and self-contained for win-x64 and win-arm64.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AssemblyName>pnmt-sensor</AssemblyName>
    <RootNamespace>PNMTD.Sensor.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Ui/pnmt-icon.svg, rendered to pnmt.ico (16–256 px) and logo.png (96 px) with rsvg-convert and ImageMagick. -->
    <ApplicationIcon>Ui\pnmt.ico</ApplicationIcon>
    <Product>PNMT Sensor</Product>
    <Company>PNMT</Company>
    <Description>PNMT sensor service for Windows</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WinForms cannot be trimmed (§3.1). -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Single-file publishing would turn this analyzer on, and with it an implicit ILLink package that the
         normal build doesn't restore: the lock file would differ between build and publish. -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!--
    The published executable (tools/agent.sh: -p:AgentRuntime=win-x64): single-file, self-contained, compressed. Set here,
    not with -r and -p on the command line, which would reach PNMTD.Lib's restore too and break its lock file.
  -->
  <PropertyGroup Condition="'$(AgentRuntime)' != ''">
    <RuntimeIdentifier>$(AgentRuntime)</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Ui\pnmt.ico" LogicalName="pnmt.ico" />
    <EmbeddedResource Include="Ui\logo.png" LogicalName="logo.png" />
    <None Include="Ui\pnmt-icon.svg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PNMTD.Lib\PNMTD.Lib.csproj" />
    <!-- The service's loop, the scheduler, problems, the log file, the state, diagnostics and the join (docs/linux-sensor-plan.md
         §3.2): moved there unchanged in L2; Platform/WindowsPlatform.cs is this agent's side of it. -->
    <ProjectReference Include="..\PNMTD.Sensor.Core\PNMTD.Sensor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- What moved to PNMTD.Sensor.Core keeps its names here: its namespaces in every file, as when they were this project's. -->
    <Using Include="PNMTD.Sensor.Core" />
    <Using Include="PNMTD.Sensor.Core.Collectors" />
    <Using Include="PNMTD.Sensor.Core.Diagnostics" />
    <Using Include="PNMTD.Sensor.Core.Join" />
    <Using Include="PNMTD.Sensor.Core.Logging" />
    <Using Include="PNMTD.Sensor.Core.Resilience" />
    <Using Include="PNMTD.Sensor.Core.Service" />
    <Using Include="PNMTD.Sensor.Core.State" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

</Project>
