<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- .NET 10 (LTS): the Microsoft packages stay on 10.0.x, not 11. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- Writes the v1 OpenAPI document at build time (PNMTD.WebUI/src/api/openapi.json, §3.7). -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <!-- Pinned: Npgsql asks for 10.0.4 or later, the Design package (build only) brings 10.0.15. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <!-- The importer reads v0.12's SQLite database with plain ADO.NET (§3.4). -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- The contract harness reads what the sensor API stored straight from the database. -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="DnsClient" Version="1.8.0" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <!-- MikroTik routers (docs/mikrotik-plan.md §9.3): SSH and SFTP, and the key pairs (X25519 for
         WireGuard, Ed25519 for SSH), which .NET does not generate. SSH.NET brings BouncyCastle anyway. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- Tests: MSTest 4 on Microsoft.Testing.Platform (global.json), as in plm. -->
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.2" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageVersion Include="MSTest.Analyzers" Version="4.5.2" />
  </ItemGroup>
</Project>
