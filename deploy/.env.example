# PNMTD's settings: ./init.sh copies this file to .env (0600) and fills in the secrets.
# The app reads ASP.NET names (Section__Key), the same names as v0.12's docker-compose.yml used,
# so an existing environment: block can be copied over as it is (UPGRADING-1.0.md).

# --- the stack (read by docker-compose.yml) ------------------------------------------------------
PNMTD_IMAGE=uisach/pnmtd
PNMTD_IMAGE_TAG=v1.3.0
# The published port. 5001 is v0.12's: the URLs your sensors report to keep working.
PNMTD_PORT=5001
# 0.0.0.0: reachable on every interface, as in v0.12. 127.0.0.1 when a reverse proxy on this host is in front.
PNMTD_BIND_ADDRESS=0.0.0.0
# Generated by init.sh. The database keeps the password it was created with: never change it here alone.
PNMTD_DB_PASSWORD=

# --- the app -------------------------------------------------------------------------------------
# Shown in the UI and in notifications, to tell several instances apart.
Identity=
# The address sensors use, for the URLs the UI shows (https://pnmt.example.com). Empty: the request's.
PublicBaseUrl=
# The zone for wall-clock rules: uptime per day, "daily at 8". An IANA name; empty is UTC.
TZ=
# Behind a reverse proxy: "docker" trusts the Docker networks, or the proxy's address (::ffff:192.168.1.80).
# Needed for the real client address in rate limiting, lockout and the audit log.
Proxy=

# --- sign-in -------------------------------------------------------------------------------------
# The first admin, created when the database has no users. init.sh generates the password and shows it.
Auth__InitialAdmin__Username=admin
Auth__InitialAdmin__Password=
# Two-factor authentication: Optional (a setup prompt after sign-in) · RequiredForAdmins · Required.
# A required setup applies at once, to running sessions too.
Auth__TotpPolicy=Optional
# The name the authenticator app shows; empty is "PNMT (<Identity>)".
Auth__TotpIssuer=

# --- notifications -------------------------------------------------------------------------------
# Admin → Debug sends a test mail and a test Pushover with these, and shows the server's answer.
Smtp__Host=
# 465: TLS from the start; 587 or 25: STARTTLS when the server offers it. Empty: 25.
Smtp__Port=
Smtp__Sender=
Smtp__Username=
Smtp__Password=
Pushover__ApiKey=

# --- mail input (IMAP) ---------------------------------------------------------------------------
Mailbox__Host=
Mailbox__Username=
Mailbox__Password=

# --- uplink check ---------------------------------------------------------------------------------
UplinkCheck__SharedKey=
UplinkCheck__Url1=
UplinkCheck__Url2=

# --- AI (optional: docs/ai-operations-plan.md, deploy/README.md "AI") ------------------------------
# Off until Ai__Enabled=true and a key. Every request is in Admin → AI, with its cost.
#Ai__Enabled=true
#Ai__ApiKey=sk-or-…
#Ai__MainModel=deepseek/deepseek-v4.1-flash-1017
#Ai__VerifyModel=z-ai/glm-5.3-flashx
# The guard (TypeSafe's Jev) through OpenRouter, with the same key. Without it, no AI on mails or feeds.
#Ai__Guard__Model=typesafe/jev-1.14
# The budget per month (or Ai__Budget__Period=day). Warnings at 80 % and 90 %; at 100 % AI work waits.
#Ai__Budget__Usd=30
# Each use can be turned off on its own.
#Ai__Mail__Enabled=true
#Ai__Analysis__Enabled=true
#Ai__Analysis__IntervalMinutes=60

# --- WireGuard: MikroTik routers and custom tunnels (docs/mikrotik-plan.md §3) --------------------
# Off by default. ./init.sh --wireguard turns it on: the service pnmtd-wg (root, NET_ADMIN only) and
# the WireGuard modes for routers. Direct SSH to routers works without it.
#COMPOSE_PROFILES=wireguard
WireGuard__Enabled=false
# The port published on this host (UDP), and the address it is published on.
PNMTD_WG_PORT=51820
PNMTD_WG_BIND_ADDRESS=0.0.0.0
# What routers and tunnels dial. Set them when this host is behind NAT or a router: the external
# address (a DNS name is best) and the port forwarded to PNMTD_WG_PORT. Empty: PublicBaseUrl's host
# and PNMTD_WG_PORT. Set here, they win over the admin page.
PNMTD_WG_EXTERNAL_HOST=
PNMTD_WG_EXTERNAL_PORT=

# --- RouterOS advisories (docs/ai-operations-plan.md §10) -----------------------------------------
# PNMTD reads MikroTik's release feed and warns (the RouterOS advisories sensor, 422) when a router
# is behind a release that fixes a critical security issue. With the AI on, the AI rates each release
# with security lines; critical needs the verification model's agreement.
#Mikrotik__Advisories__Enabled=true
#Mikrotik__Advisories__FeedUrl=https://cdn.mikrotik.com/routeros/latest-stable-and-long-term.rss
#Mikrotik__Advisories__IntervalMinutes=60

# --- Servers with an agent, Windows and Linux (docs/linux-sensor-plan.md §9.5) ----------------------
# The agents connect on PNMT's address and port (no port to open); behind nginx see deploy/README.md.
#Agents__Enabled=true
#Agents__HeartbeatSeconds=60
#Agents__FullUpdateHours=6
# How long a join token is valid by default (hours, at most 168).
#Agents__TokenHours=24
# A heartbeat whose clock is further off writes 451 (Windows) or 461 (Linux).
#Agents__MaxClockSkewSeconds=120
#Agents__JoinRateLimitPerMinute=10
# Failed logins counted for 454 and 464 over this many minutes (the threshold is per server).
#Agents__FailedLoginWindowMinutes=10
#Agents__KeepLoginsDays=180
#Agents__KeepChangesDays=180
#Agents__KeepAgentLogDays=365
# Linux: a key removal for an offline server waits this many days for it; the removals' history is kept a year.
#Agents__KeyRemovalPendingDays=7
#Agents__KeepKeyRemovalsDays=365
# Where Admin → Servers → Download links to: {base}/sensor-{version}/pnmt-sensor-x64.exe
#Agents__AgentDownloadBaseUrl=https://github.com/muqiuq/PNMTD/releases/download

# --- locations and the knowledge base (docs/locations-knowledge-plan.md §8.4, §8.5) ---------------
# The folder on this host with the images and attachments of pages and locations: a bind mount, not a
# volume, so the host's own tools can back it up and measure it. Start it with ./ (relative to this
# folder) or /: /srv/pnmtd-files puts it on a disk of its own. ./init.sh creates it for the app's user
# (uid 1654, 0750), ./backup.sh includes it (--no-files leaves it out). Never change, rename or delete
# files in it from the host: Admin → Knowledge base → Files deletes them.
PNMTD_FILES_DIR=./files
# At most 2 MB per image and 25 MB per attachment; a reverse proxy in front needs a body limit above it.
#KnowledgeBase__MaxImageBytes=2097152
#KnowledgeBase__MaxAttachmentBytes=26214400
#KnowledgeBase__BlockedExtensions=exe msi dll scr com bat cmd ps1 vbs js jar hta lnk
#KnowledgeBase__UploadsPerHour=200
# Below this much free space on the folder's disk, the File storage sensor writes 428.
#KnowledgeBase__MinFreeMb=1024
# AI tags for pages, while the AI is on; how often (percent) the question follows a saved edit.
#KnowledgeBase__AiTags=true
#KnowledgeBase__AiQuestionOnEditPercent=10

# --- backups ---------------------------------------------------------------------------------------
# Relative to this folder; ./backup.sh --keep overrides PNMTD_BACKUP_KEEP.
PNMTD_BACKUP_DIR=backups
PNMTD_BACKUP_KEEP=14
